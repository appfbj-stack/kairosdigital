// ============================================
// HERMES OS — Prisma Schema (Multi-tenant)
// ============================================

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================
enum UserRole {
  SUPERADMIN
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum PlanTier {
  BASIC
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
  ARCHIVED
}

enum WhatsAppStatus {
  DISCONNECTED
  CONNECTING
  QR_CODE
  CONNECTED
  ERROR
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  CONTACT
  STICKER
  SYSTEM
}

enum ConversationChannel {
  WHATSAPP
  WEB
  EMAIL
  SMS
  API
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELED
  COMPLETED
  NO_SHOW
}

enum AutomationTrigger {
  MESSAGE_RECEIVED
  CONTACT_CREATED
  STAGE_CHANGED
  TIME_BASED
  TAG_ADDED
  MANUAL
  WEBHOOK
}

enum AutomationStatus {
  ACTIVE
  PAUSED
  DRAFT
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  CRITICAL
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
}

// ============================================
// PLANS / BILLING (global)
// ============================================
model Plan {
  id              String   @id @default(uuid())
  tier            PlanTier @unique
  name            String
  description     String?
  priceMonthly    Decimal  @db.Decimal(10, 2)
  priceYearly     Decimal? @db.Decimal(10, 2)
  currency        String   @default("BRL")
  // Limits
  maxUsers          Int     @default(5)
  maxWhatsApps      Int     @default(2)
  maxAiMessages     Int     @default(1500)
  maxContacts       Int     @default(5000)
  maxAutomations    Int     @default(10)
  maxStorageMb      Int     @default(1024)
  // Feature flags
  features        Json     @default("{}")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   Subscription[]

  @@map("plans")
}

// ============================================
// TENANTS (raiz multi-tenant)
// ============================================
model Tenant {
  id            String       @id @default(uuid())
  slug          String       @unique
  name          String
  status        TenantStatus @default(ACTIVE)
  logoUrl       String?
  primaryColor  String?      @default("#6366f1")
  timezone      String       @default("America/Sao_Paulo")
  locale        String       @default("pt-BR")
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  suspendedAt   DateTime?

  // Relations
  users               User[]
  subscription        Subscription?
  contacts            Contact[]
  conversations       Conversation[]
  messages            Message[]
  tasks               Task[]
  appointments        Appointment[]
  pipelines           Pipeline[]
  automations         Automation[]
  whatsappInstances   WhatsAppInstance[]
  aiUsages            AiUsage[]
  messageUsages       MessageUsage[]
  logs                AuditLog[]
  notifications       Notification[]
  agentMemories       AgentMemory[]
  apiKeys             ApiKey[]
  invitations         Invitation[]
  mercadolivreIntegration MercadoLivreIntegration?

  @@index([status])
  @@map("tenants")
}

// ============================================
// SUBSCRIPTIONS
// ============================================
model Subscription {
  id            String             @id @default(uuid())
  tenantId      String             @unique
  planId        String
  status        SubscriptionStatus @default(TRIAL)
  startedAt     DateTime           @default(now())
  trialEndsAt   DateTime?
  currentPeriodStart DateTime      @default(now())
  currentPeriodEnd   DateTime
  canceledAt    DateTime?
  externalId    String? // Gateway de pagamento
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

// ============================================
// USERS
// ============================================
model User {
  id            String    @id @default(uuid())
  tenantId      String?   // null = superadmin global
  email         String
  passwordHash  String
  name          String
  avatarUrl     String?
  role          UserRole  @default(MEMBER)
  isActive      Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt   DateTime?
  phone         String?
  locale        String    @default("pt-BR")
  timezone      String    @default("America/Sao_Paulo")
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions      Session[]
  conversations Conversation[]  @relation("AssignedAgent")
  tasksCreated  Task[]          @relation("TaskCreator")
  tasksAssigned Task[]          @relation("TaskAssignee")
  appointments  Appointment[]
  auditLogs     AuditLog[]
  notifications Notification[]
  apiKeys       ApiKey[]
  aiUsages      AiUsage[]

  @@unique([tenantId, email])
  @@index([email])
  @@index([role])
  @@map("users")
}

// ============================================
// SESSIONS / API KEYS
// ============================================
model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String?
  name       String
  keyHash    String    @unique
  prefix     String    // primeiros 8 chars para identificação
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([prefix])
  @@map("api_keys")
}

model Invitation {
  id         String    @id @default(uuid())
  tenantId   String
  email      String
  role       UserRole  @default(MEMBER)
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@map("invitations")
}

// ============================================
// CONTACTS / CRM
// ============================================
model Contact {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  email         String?
  phone         String?
  whatsappJid   String?
  avatarUrl     String?
  company       String?
  jobTitle      String?
  tags          String[] @default([])
  customFields  Json     @default("{}")
  notes         String?
  source        String?  // origem: lead-form, manual, import, whatsapp...
  pipelineStageId String?
  ownerId       String?
  lastInteractionAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipelineStage  PipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  conversations  Conversation[]
  tasks          Task[]
  appointments   Appointment[]

  @@unique([tenantId, phone])
  @@index([tenantId, name])
  @@index([tenantId, email])
  @@index([tenantId, ownerId])
  @@map("contacts")
}

// ============================================
// PIPELINES / DEALS
// ============================================
model Pipeline {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages PipelineStage[]

  @@index([tenantId])
  @@map("pipelines")
}

model PipelineStage {
  id         String   @id @default(uuid())
  pipelineId String
  name       String
  order      Int      @default(0)
  color      String?
  probability Int?    @default(0) // 0-100
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pipeline Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  contacts Contact[]

  @@index([pipelineId, order])
  @@map("pipeline_stages")
}

// ============================================
// CONVERSATIONS / MESSAGES
// ============================================
model Conversation {
  id              String              @id @default(uuid())
  tenantId        String
  contactId       String?
  channel         ConversationChannel @default(WEB)
  status          ConversationStatus  @default(OPEN)
  title           String?
  assignedAgentId String?
  whatsappInstanceId String?
  isAiHandled     Boolean             @default(false)
  unreadCount     Int                 @default(0)
  lastMessageAt   DateTime?
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact           Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedAgent     User?             @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  whatsappInstance  WhatsAppInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)
  messages          Message[]

  @@index([tenantId, status])
  @@index([tenantId, channel])
  @@index([tenantId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid())
  tenantId       String
  conversationId String
  externalId     String?          // ID na Evolution / outro provider
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  status         MessageStatus    @default(SENT)
  content        String?          @db.Text
  mediaUrl       String?
  mediaMimeType  String?
  senderName     String?
  senderId       String?          // userId, contactId ou "ai-agent"
  isAiGenerated  Boolean          @default(false)
  aiModel        String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([conversationId, createdAt])
  @@index([externalId])
  @@map("messages")
}

// ============================================
// TASKS / AGENDA
// ============================================
model Task {
  id          String       @id @default(uuid())
  tenantId    String
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime?
  completedAt DateTime?
  creatorId   String?
  assigneeId  String?
  contactId   String?
  tags        String[]     @default([])
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator  User?    @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  assignee User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, dueAt])
  @@map("tasks")
}

model Appointment {
  id          String            @id @default(uuid())
  tenantId    String
  title       String
  description String?           @db.Text
  startAt     DateTime
  endAt       DateTime
  location    String?
  meetingUrl  String?
  status      AppointmentStatus @default(SCHEDULED)
  userId      String?
  contactId   String?
  reminderMinutes Int?          @default(15)
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([tenantId, startAt])
  @@map("appointments")
}

// ============================================
// AUTOMATIONS
// ============================================
model Automation {
  id          String            @id @default(uuid())
  tenantId    String
  name        String
  description String?
  trigger     AutomationTrigger
  status      AutomationStatus  @default(DRAFT)
  conditions  Json              @default("[]")
  actions     Json              @default("[]")
  runCount    Int               @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([trigger])
  @@map("automations")
}

// ============================================
// WHATSAPP
// ============================================
model WhatsAppInstance {
  id              String         @id @default(uuid())
  tenantId        String
  name            String         // alias amigável
  instanceName    String         @unique // nome único na Evolution API
  apiKey          String?        // hash da chave da instância
  phoneNumber     String?
  status          WhatsAppStatus @default(DISCONNECTED)
  qrCode          String?        @db.Text
  qrCodeExpiresAt DateTime?
  profileName     String?
  profileAvatarUrl String?
  lastConnectionAt DateTime?
  webhookUrl      String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  messageUsages MessageUsage[]

  @@index([tenantId])
  @@index([status])
  @@map("whatsapp_instances")
}

// ============================================
// USAGE / BILLING TRACKING
// ============================================
model AiUsage {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String?
  model        String
  promptTokens Int      @default(0)
  completionTokens Int  @default(0)
  totalTokens  Int      @default(0)
  costUsd      Decimal? @db.Decimal(10, 6)
  agentName    String?
  conversationId String?
  metadata     Json?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, model])
  @@map("ai_usages")
}

model MessageUsage {
  id                 String   @id @default(uuid())
  tenantId           String
  whatsappInstanceId String?
  direction          MessageDirection
  count              Int      @default(1)
  date               DateTime @default(now()) @db.Date

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappInstance WhatsAppInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, whatsappInstanceId, direction, date])
  @@index([tenantId, date])
  @@map("message_usages")
}

// ============================================
// AGENT MEMORY (IA contextual por tenant)
// ============================================
model AgentMemory {
  id         String   @id @default(uuid())
  tenantId   String
  agentName  String   // "crm", "agenda", "followup"...
  scope      String   // "tenant", "user:<id>", "contact:<id>"
  key        String
  value      Json
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, agentName, scope, key])
  @@index([tenantId, agentName])
  @@map("agent_memories")
}

// ============================================
// LOGS / NOTIFICATIONS
// ============================================
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String?
  action     String   // "user.login", "contact.create", "whatsapp.connect"...
  resource   String?  // "contact:<id>"
  level      LogLevel @default(INFO)
  message    String?  @db.Text
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([action])
  @@index([level])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  userId    String?
  type      NotificationType @default(INFO)
  title     String
  body      String?          @db.Text
  link      String?
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

model MercadoLivreIntegration {
  id             String    @id @default(uuid())
  tenantId       String
  meliUserId     BigInt
  meliNickname   String?
  accessToken    String
  refreshToken   String
  tokenExpiresAt DateTime
  scopes         String[]  @default([])
  isConnected    Boolean   @default(true)
  connectedAt    DateTime  @default(now())
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@map("mercadolivre_integrations")
}
