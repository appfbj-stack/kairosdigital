generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Vertical {
  REAL_ESTATE
  AUTOMOTIVE
  RETAIL
  FOOD_SERVICE
  HEALTH
  BEAUTY
  EDUCATION
  SERVICES
  CUSTOM
}

enum LeadStatus { NEW QUALIFIED CONTACTED PROPOSAL NEGOTIATION WON LOST }
enum DealStage  { PROSPECT QUALIFICATION PROPOSAL NEGOTIATION CLOSED_WON CLOSED_LOST }
enum TaskStatus { PENDING IN_PROGRESS DONE CANCELLED }
enum UserRole   { OWNER ADMIN MANAGER VIEWER }

model Tenant {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  tradeName       String?
  vertical        Vertical @default(CUSTOM)
  
  // Branding
  logoUrl         String?
  primaryColor    String   @default("#2563eb")
  secondaryColor  String   @default("#1e40af")
  welcomeMsg      String?
  
  // Config vertical (JSON flexível)
  verticalConfig  Json     @default("{}")
  customPrompt    String?
  
  // Evolution GO
  evolutionInstance String? @unique
  evolutionToken    String?
  
  // Relacionamentos
  users           User[]
  leads           Lead[]
  deals           Deal[]
  tasks           Task[]
  conversations   Conversation[]
  knowledgeBase   KnowledgeBase[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([slug])
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  role      UserRole @default(ADMIN)
  passwordHash String?
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([tenantId, email])
  @@index([tenantId])
}

model Lead {
  id            String     @id @default(uuid())
  tenantId      String
  phone         String     // E.164: 5511999999999
  name          String?
  email         String?
  source        String?    // whatsapp, site, indicacao, ads
  tags          String[]   @default([])
  score         Int        @default(0)
  status        LeadStatus @default(NEW)
  customData    Json       @default("{}")
  
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals         Deal[]
  tasks         Task[]
  conversations Conversation[]
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@unique([tenantId, phone])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model Deal {
  id                String     @id @default(uuid())
  tenantId          String
  leadId            String
  title             String
  value             Decimal    @db.Decimal(12, 2)
  stage             DealStage  @default(PROSPECT)
  expectedCloseDate DateTime?
  metadata          Json       @default("{}")
  
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead              Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  
  @@index([tenantId, stage])
  @@index([tenantId, leadId])
}

model Task {
  id          String      @id @default(uuid())
  tenantId    String
  leadId      String?
  title       String
  description String?
  dueAt       DateTime?
  assignee    String?     // userId ou "hermes"
  status      TaskStatus  @default(PENDING)
  metadata    Json        @default("{}")
  
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@index([tenantId, assignee, status])
  @@index([tenantId, dueAt])
}

model Conversation {
  id          String   @id @default(uuid())
  tenantId    String
  leadId      String
  channel     String   @default("whatsapp")
  direction   String   @default("INBOUND") // INBOUND, OUTBOUND
  content     String   // mensagem completa
  summary     String?  // gerado pelo Hermes
  tokens      Int?     // custo LLM
  metadata    Json     @default("{}")
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  
  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, createdAt])
}

model KnowledgeBase {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  content     String
  tags        String[] @default([])
  embedding   Unsupported("vector(1536)")? // pgvector
  metadata    Json     @default("{}")
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
  @@index([tenantId, tags])
}